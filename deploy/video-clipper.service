[Unit]
Description=Video Clipper API
After=network.target

[Service]
Type=simple
User=videoclip
Group=videoclip
WorkingDirectory=/srv/video-clipper/backend
Environment=VC_DATA_DIR=/srv/video-clipper/data
Environment=VC_MAX_UPLOAD_BYTES=524288000
# Keep processed clips for 24h; cleaned by the sweeper every 15 min.
Environment=VC_RETENTION_HOURS=24
Environment=VC_CLEANUP_INTERVAL=900
Environment=VC_MIN_FREE_BYTES=1073741824
ExecStart=/srv/video-clipper/.venv/bin/uvicorn app.main:app --workers 1 --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

# Resource limits: protect a 1 vCPU / 1 GB box from runaway FFmpeg.
# NOTE: CPUQuota is unsupported inside OpenVZ/Virtuozzo containers (cgroup
# cpu.cfs_quota_us is read-only) and spams the journal, so we rely on Nice and
# the memory cap instead.
MemoryMax=700M
MemoryHigh=600M
Nice=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/video-clipper/data

[Install]
WantedBy=multi-user.target
